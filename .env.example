# Salin ke .env lalu isi
PORT=8000
HOST=127.0.0.1
DATABASE_URL=postgres://vertonik:vertonik123@127.0.0.1:5432/vertonik_smartfarm

# Kunci rahasia: JWT (HS256) + enkripsi data (AES-256-CBC kompatibel Laravel APP_KEY)
JWT_SECRET=ganti-dengan-acak-panjang
# base64 32 byte — BISA memakai nilai APP_KEY Laravel agar data lama tetap terbaca
APP_KEY=

# API key perangkat ESP32 (header X-API-KEY)
ESP32_API_KEY=HARVEST123

# HTTPS opsional (1 = aktif, memakai/generate self-signed cert di ./certs)
HTTPS=0
