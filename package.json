{
  "name": "garap-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API GARAP (Node.js) — menggantikan Laravel, JSON-only + terenkripsi",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "start:https": "HTTPS=1 node src/index.js",
    "test": "node --test \"test/**/*.test.js\"",
    "migrate": "node scripts/migrate.js",
    "migrate:status": "node scripts/migrate.js --status",
    "db:seed-fake": "psql \"$DATABASE_URL\" -f database/seed_fake.sql",
    "sim:sensor": "node scripts/simulasi-sensor.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mqtt": "^5.16.1",
    "pg": "^8.13.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "aedes": "^0.51.3",
    "supertest": "^7.3.1"
  }
}
